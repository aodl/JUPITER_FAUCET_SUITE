#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
cd "$REPO_ROOT"

artifact="release-artifacts/jupiter_historian.wasm.gz"
deprecated_artifact="release-artifacts/jupiter_historian_with_relay.wasm.gz"
manifest="release-artifacts/release-artifacts.sha256"

if [[ ! -f "$manifest" ]]; then
  echo "missing canonical release artifact manifest: ${manifest}" >&2
  echo "run the sanctioned Docker build separately before this read-only preflight: ./tools/scripts/docker-build" >&2
  exit 1
fi

if [[ ! -f "$artifact" ]]; then
  echo "expected canonical relay-enabled historian artifact is missing: ${artifact}" >&2
  echo "run the sanctioned Docker build separately before this read-only preflight: ./tools/scripts/docker-build" >&2
  exit 1
fi

missing_manifest_artifacts=0
while read -r _hash path _rest; do
  [[ -z "${path:-}" ]] && continue
  if [[ ! -f "$path" ]]; then
    echo "manifest artifact is missing: ${path}" >&2
    missing_manifest_artifacts=1
  fi
done < "$manifest"
if [[ "$missing_manifest_artifacts" -ne 0 ]]; then
  echo "run the sanctioned Docker build separately before this read-only preflight: ./tools/scripts/docker-build" >&2
  exit 1
fi

sha256sum -c "$manifest"
python3 ./tools/scripts/validate-mainnet-install-args

echo
echo "Production historian deploy artifact path:"
echo "$artifact"
echo
echo "Artifact hashes:"
cat release-artifacts/jupiter_historian.reviewed-relay-wasm-raw.sha256
cat release-artifacts/jupiter_historian.embedded-relay-wasm-gz.sha256
sha256sum "$artifact"

if [[ -f "$deprecated_artifact" ]]; then
  deprecated_hash="$(sha256sum "$deprecated_artifact" | awk '{print $1}')"
  canonical_hash="$(sha256sum "$artifact" | awk '{print $1}')"
  if [[ "$deprecated_hash" != "$canonical_hash" ]]; then
    echo "refusing preflight: deprecated historian-with-relay artifact exists with different bytes: ${deprecated_artifact}" >&2
    exit 1
  fi
fi

echo
echo "Read-only preflight only. Existing production Historian must be upgraded in place."
echo "Reinstall destroys all stable history, tracking metadata, Relay registrations, and setup/recovery jobs; it is prohibited for the existing production Historian."
echo "canisters/historian/mainnet-install-args.did is fresh-install-only for Historian and must not be passed to upgrade."
echo "Before stopping Historian, record pre-upgrade query results. Stopping jupiter_historian is the executable self-service factory pause."
echo "Complete tested maintenance sequence after release signoff:"
cat <<'CMD'
icp canister stop jupiter_historian --environment ic
JUPITER_USE_CANONICAL_ARTIFACTS=1 \
icp deploy jupiter_historian \
  --environment ic \
  --mode upgrade
icp canister start jupiter_historian --environment ic
icp canister status jupiter_historian --environment ic --json
CMD
echo
echo "Local icp 0.2.6 testing showed the stopped-canister upgrade leaves the canister stopped; the explicit start command is required."
echo "Stable memory 29 is authoritative Historian state and must be preserved by the in-place upgrade."
echo "Query get_commitment_route_summaries anonymously before and after upgrade; normal production should report complete_from_genesis=true and commitment_index_fault=null."
cat <<'CMD'
icp canister call jupiter_historian get_commitment_route_summaries \
  '(record { routes = vec {} })' \
  --environment ic \
  --identity anonymous \
  --query
CMD
echo
echo "Preserve memory-26 setup entries, exact active configuration mappings, and RelayTarget/RelayInstance tracking; record representative known configurations before upgrade and verify them afterwards."
echo "Snapshots are risk-based. Strongly recommend or require one for stable-schema, stable-memory-layout, migration, authoritative-history, or other rollback-sensitive changes; see docs/operations/deployment.md."
echo
echo "The command above resolves jupiter_historian through icp.yaml, which must build/copy:"
echo "$artifact"
