#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

cd "$REPO_ROOT"

if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required to verify reproducible release artifacts" >&2
  exit 1
fi

if ! docker buildx version >/dev/null 2>&1; then
  echo "docker buildx is required to verify reproducible release artifacts" >&2
  exit 1
fi

workdir="$(mktemp -d)"
containers=()
images=()
cleanup() {
  for container in "${containers[@]}"; do
    docker rm -f "$container" >/dev/null 2>&1 || true
  done
  for image in "${images[@]}"; do
    docker image rm -f "$image" >/dev/null 2>&1 || true
  done
  rm -rf "$workdir"
}
trap cleanup EXIT

extract_artifacts() {
  local run_name="$1"
  local dest="$2"
  local tag_suffix
  local image
  local container

  tag_suffix="$(date +%s)-$$-${run_name}-${RANDOM}"
  image="jupiter-repro-artifact-verify:${tag_suffix}"
  images+=("$image")

  mkdir -p "$dest"
  docker build \
    --builder default \
    --platform linux/amd64 \
    --no-cache \
    --file Dockerfile.repro \
    --target artifact \
    --tag "$image" \
    .

  container="$(docker create "$image" /bin/true)"
  containers+=("$container")
  docker cp "$container:/release-artifacts/." "$dest/"
  docker rm -f "$container" >/dev/null
  container=""
  docker image rm -f "$image" >/dev/null
  image=""
}

extract_artifacts "run-a" "$workdir/run-a"
extract_artifacts "run-b" "$workdir/run-b"

(
  cd "$workdir/run-a"
  find . -type f -print0 | sort -z | xargs -0 sha256sum
) > "$workdir/run-a.sha256"
(
  cd "$workdir/run-b"
  find . -type f -print0 | sort -z | xargs -0 sha256sum
) > "$workdir/run-b.sha256"

if ! diff -u "$workdir/run-a.sha256" "$workdir/run-b.sha256"; then
  echo "release artifacts differ between clean same-environment rebuilds" >&2
  exit 1
fi

echo "release artifacts match across clean same-environment rebuilds"
