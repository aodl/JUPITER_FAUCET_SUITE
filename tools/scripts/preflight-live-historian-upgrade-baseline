#!/usr/bin/env python3
import argparse
import json
import os
import re
import subprocess
import sys

HISTORIAN_CANISTER_ID = "j5gs6-uiaaa-aaaar-qb5cq-cai"
EXPECTED_ENV = "EXPECTED_HISTORIAN_LEGACY_MODULE_HASH"

# This script must never mutate the canister. It only runs `icp canister status`.


def normalize_hash(value: str) -> str:
    value = value.strip().lower()
    if value.startswith("0x"):
        value = value[2:]
    if not re.fullmatch(r"[0-9a-f]{64}", value):
        raise ValueError("module hash must be 64 hex characters, with optional 0x prefix")
    return value


def parse_status(status_json: str) -> tuple[str, list[str]]:
    data = json.loads(status_json)
    module_hash = data.get("module_hash")
    if not isinstance(module_hash, str):
        raise ValueError("status JSON is missing string field module_hash")
    settings = data.get("settings")
    if not isinstance(settings, dict):
        raise ValueError("status JSON is missing object field settings")
    controllers = settings.get("controllers")
    if not isinstance(controllers, list) or not all(isinstance(item, str) for item in controllers):
        raise ValueError("status JSON is missing settings.controllers string list")
    return normalize_hash(module_hash), controllers


def run_status_query() -> str:
    completed = subprocess.run(
        [
            "icp",
            "canister",
            "status",
            HISTORIAN_CANISTER_ID,
            "-n",
            "ic",
            "--json",
        ],
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    )
    return completed.stdout


def self_test() -> None:
    fixture = json.dumps(
        {
            "id": HISTORIAN_CANISTER_ID,
            "module_hash": "0x" + "a" * 64,
            "settings": {"controllers": ["aaaaa-aa", "bbbbbb-bb"]},
        }
    )
    module_hash, controllers = parse_status(fixture)
    assert module_hash == "a" * 64
    assert controllers == ["aaaaa-aa", "bbbbbb-bb"]
    for bad in [
        {},
        {"module_hash": "abc", "settings": {"controllers": []}},
        {"module_hash": "0x" + "b" * 64, "settings": {}},
    ]:
        try:
            parse_status(json.dumps(bad))
        except ValueError:
            pass
        else:
            raise AssertionError(f"bad fixture unexpectedly parsed: {bad}")
    print("preflight-live-historian-upgrade-baseline self-tests OK")


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Read-only live Historian legacy-baseline module-hash gate."
    )
    parser.add_argument(
        "expected_module_hash",
        nargs="?",
        help=f"Expected live legacy module hash, or set {EXPECTED_ENV}.",
    )
    parser.add_argument("--self-test", action="store_true", help="Run offline parser self-tests.")
    args = parser.parse_args()

    if args.self_test:
        self_test()
        return 0

    expected_raw = args.expected_module_hash or os.environ.get(EXPECTED_ENV)
    if not expected_raw:
        print(
            f"missing expected module hash: pass it as an argument or set {EXPECTED_ENV}",
            file=sys.stderr,
        )
        return 2
    try:
        expected = normalize_hash(expected_raw)
        live_hash, controllers = parse_status(run_status_query())
    except (ValueError, subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        print(f"failed to query/parse live Historian status: {exc}", file=sys.stderr)
        return 1

    print(f"Historian canister: {HISTORIAN_CANISTER_ID}")
    print(f"Live module hash: {live_hash}")
    print("Controllers:")
    for controller in controllers:
        print(f"- {controller}")
    if live_hash != expected:
        print(
            "live Historian module hash does not match the expected 98c871a legacy baseline; "
            "stop deployment and identify the actual deployed source revision before migration",
            file=sys.stderr,
        )
        return 1
    print("Live Historian module hash matches expected legacy baseline.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
