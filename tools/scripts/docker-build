#!/usr/bin/env bash
set -euo pipefail

docker_build_args() {
  local image_tag="$1"
  local -a docker_cache_args=()
  if [[ "${JUPITER_DOCKER_NO_CACHE:-0}" == "1" ]]; then
    docker_cache_args+=(--no-cache)
  fi

  printf '%s\0' \
    --builder default \
    "${docker_cache_args[@]}" \
    --platform linux/amd64 \
    --target artifact \
    --tag "$image_tag" \
    -f Dockerfile.repro \
    .
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

command -v docker >/dev/null 2>&1 || {
  echo "docker is required but not installed or not on PATH" >&2
  exit 1
}

docker buildx version >/dev/null 2>&1 || {
  echo "docker buildx is required but not available" >&2
  exit 1
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

cd "$REPO_ROOT"

rm -rf "release-artifacts" ".repro-out"
mkdir -p ".repro-out" "release-artifacts"

tag_suffix="$(date +%s)-$$-${RANDOM}"
artifact_image="jupiter-repro-artifact:${tag_suffix}"
artifact_container=""
mapfile -d '' -t docker_args < <(docker_build_args "$artifact_image")

cleanup() {
  if [ -n "$artifact_container" ]; then
    docker rm -f "$artifact_container" >/dev/null 2>&1 || true
  fi
  docker image rm -f "$artifact_image" >/dev/null 2>&1 || true
  rm -rf ".repro-out"
}
trap cleanup EXIT

docker build "${docker_args[@]}"

artifact_container="$(docker create "$artifact_image" /bin/true)"
docker cp "$artifact_container:/release-artifacts/." "./.repro-out/"

if [ -d "./.repro-out/release-artifacts" ]; then
  cp -a "./.repro-out/release-artifacts/." "./release-artifacts/"
else
  cp -a "./.repro-out/." "./release-artifacts/"
fi

echo
echo "Built canonical artifacts in release-artifacts/"

manifest="release-artifacts/release-artifacts.sha256"
manifest_tmp="$(mktemp)"
find "release-artifacts" \
  -maxdepth 2 \
  -type f \
  ! -name 'release-artifacts.sha256' \
  \( -name '*.wasm' -o -name '*.wasm.gz' -o -name '*.sha256' -o -name 'build-info.json' \) \
  -print0 |
  sort -z |
  xargs -0 sha256sum > "$manifest_tmp"
mv "$manifest_tmp" "$manifest"

echo
echo "Mainnet module-hash comparison targets (*.wasm.gz):"
find "release-artifacts" \
  -maxdepth 1 \
  -type f \
  -name '*.wasm.gz' \
  -print0 |
  sort -z |
  while IFS= read -r -d '' wasm_gz; do
    sha="$(sha256sum "$wasm_gz" | awk '{print $1}')"
    printf '%s  %s\n' "$sha" "$(basename "$wasm_gz")"
  done

echo
echo "Full artifact manifest:"
echo "$manifest"

echo
echo "Verify manifest:"
echo "sha256sum -c $manifest"
