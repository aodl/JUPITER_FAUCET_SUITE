type Account = record {
  owner : principal;
  subaccount : opt blob;
};
type EventHorizonPokeTarget = variant { subaccount : nat64; neuron_nonce : nat64 };
type EventHorizonPokeMatch = record { target : EventHorizonPokeTarget; max_amount : nat };

type InitArgs = record {
  neuron_id : nat64;

  normal_recipient : Account;
  age_bonus_recipient_1 : Account;
  age_bonus_recipient_2 : Account;

  ledger_canister_id : opt principal;
  governance_canister_id : opt principal;

  rescue_controller : principal;
  autonomous_rescue_armed : opt bool;

  main_interval_seconds : opt nat64;
  rescue_interval_seconds : opt nat64;
};

service : (InitArgs) -> {
  poke : (vec EventHorizonPokeMatch) -> ();
}
